
# Nombre del proyecto Docker Compose
COMPOSE_PROJECT_NAME=06-dev-postgresql


# PostgreSQL: usuario y contraseña de conexion, nombre de la base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# PostgreSQL: puerto expuesto en el host
POSTGRES_PORT=5432  



# pgAdmin: http://localhost:5050
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambia_esto





