# IMPORTANTE:
# Este archivo contiene datos sensibles y NO debe subirse a GIT.
# Solo para fines de prueba y aprendizaje.


# Nombre del proyecto Docker Compose
COMPOSE_PROJECT_NAME=06-dev-postgresql


# PostgreSQL: usuario y contraseña de conexion, nombre de la base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# PostgreSQL: puerto expuesto en el host
POSTGRES_PORT=5432  




